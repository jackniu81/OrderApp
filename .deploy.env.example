# 单机部署环境变量（docker compose --env-file .deploy.env -f docker-compose.prod.yml）
# 复制为 .deploy.env 后修改；.deploy.env 不要提交进仓库。

# ====== 数据库 ======
DB_ROOT_PASSWORD=change_me_strong_root_password
DB_NAME=orderapp

# ====== Redis ======
REDIS_PASSWORD=change_me_strong_redis_password

# ====== 鉴权 ======
# 必须换成 ≥32 位随机串：openssl rand -hex 32
JWT_SECRET=replace_with_a_random_secret_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# ====== 对外端口 ======
HTTP_PORT=80

# ====== 微信小程序 / 微信支付 ======
# 留空时顾客端走「模拟支付」沙箱；正式上线必须填齐
WX_APPID=
WX_APPSECRET=
WX_PAY_MCH_ID=
WX_PAY_API_V3_KEY=
WX_PAY_PRIVATE_KEY_PATH=
WX_PAY_CERT_PATH=
WX_PAY_NOTIFY_URL=

# 到店支付默认开关（商家后台可单独覆盖）
DEFAULT_PAY_ON_SITE_ENABLED=true
