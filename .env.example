# ====== 数据库 ======
DATABASE_URL="mysql://root:rootpassword@localhost:3306/orderapp?schema=public&connection_limit=10&pool_timeout=0"

# ====== Redis ======
REDIS_URL="redis://localhost:6379"

# ====== 服务 ======
PORT=3000
NODE_ENV=development

# ====== JWT ======
JWT_SECRET="replace_with_a_random_secret_key_at_least_32_chars"
JWT_EXPIRES_IN="7d"

# ====== 微信小程序 ======
# 小程序 AppID / AppSecret（顾客端登录换 openid）
WX_APPID=""
WX_APPSECRET=""

# ====== 微信支付 ======
# 商户号、APIv3 密钥、证书路径
WX_PAY_MCH_ID=""
WX_PAY_API_V3_KEY=""
WX_PAY_PRIVATE_KEY_PATH=""
WX_PAY_CERT_PATH=""
WX_PAY_NOTIFY_URL=""

# ====== 到店支付开关（商家可在后台单独设置，这里是默认值）======
DEFAULT_PAY_ON_SITE_ENABLED=true
