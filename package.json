{
  "name": "order-template",
  "version": "0.1.0",
  "private": true,
  "description": "单店自提点餐可复用模板（微信小程序 + 后台管理 + Node 后端）",
  "workspaces": [
    "apps/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w server",
    "build": "npm run build -w server",
    "start": "npm run start -w server",
    "seed": "npm run seed -w server",
    "migrate": "npm run migrate -w server",
    "ci": "npm run ci -w server",
    "miniapp:dev:weapp": "npm run dev:weapp -w miniapp",
    "miniapp:dev:h5": "npm run dev:h5 -w miniapp",
    "miniapp:build": "npm run build:weapp -w miniapp",
    "miniapp:typecheck": "npm run typecheck -w miniapp",
    "miniapp:test": "npm run test -w miniapp",
    "admin:dev": "npm run dev -w admin",
    "admin:build": "npm run build -w admin",
    "admin:typecheck": "npm run typecheck -w admin"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tarojs/taro-loader": "^4.3.0"
  }
}
